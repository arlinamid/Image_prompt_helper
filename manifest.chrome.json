{
  "manifest_version": 3,
  "name": "Image Prompt Helper",
  "description": "A curated library of 3,143 prompt keywords + AI enhancement for AI image generation",
  "version": "1.2.0",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "js": ["assets/contentScript.js"],
      "matches": [
        "https://www.bing.com/*",
        "https://tengr.ai/*",
        "https://app.leonardo.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://ideogram.ai/*"
      ],
      "css": ["assets/style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.bing.com/*",
        "https://tengr.ai/*",
        "https://app.leonardo.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://ideogram.ai/*"
      ],
      "resources": ["assets/*"],
      "use_dynamic_url": false
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://tengr.ai/*",
    "https://app.leonardo.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://ideogram.ai/*"
  ]
}

